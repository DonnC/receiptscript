receipt "sme"
meta:
  width: 32
  font: 24
use header "merchant-header"
use footer "customer-footer"
body:
  kv "RECEIPT" "{{txn.reference}}"
  kv "CASHIER" "{{cashier}}"
  divider "_"
  table:
    headers: "ITEM" "QTY" "TOTAL"
    weights: 4 1 3
    alignments: start center end
    for item in items:
      row "{{item.name}}" "{{item.qty}}" "{{item.total | money:txn.currency}}"
  divider "_"
  kv "SUBTOTAL" "{{txn.subtotal | money:txn.currency}}"
  kv "TAX (15%)" "{{txn.tax | money:txn.currency}}"
  kv bold "TOTAL" "{{txn.total | money:txn.currency}}"
  kv "TENDERED" "{{payment.tendered | money:txn.currency}}"
  kv "CHANGE" "{{payment.change | money:txn.currency}}"
  barcode "{{txn.reference}}" 300 60 "code128"
