receipt "daily_total"

meta:
  width: 34
  paper: "40mm"
  copy: "merchant"
  templateVersion: 3

if logoRef:
  image "{{logoRef}}" 300 300
  spacer 1

center big bold "*** DAILY TOTALS ***"
center bold "{{merchant.merchantName}}"
if merchant.location:
  center small "{{merchant.location}}"
center small "TID: {{terminal.tid}}"
center small "Device: {{terminal.serialNo}}"
spacer 1

kv "DATE" "{{report.selectedDate}}"
kv "GENERATED" "{{report.generatedAt}}"
kv "TOTAL TRANSACTIONS" "{{report.totalCount}}"
spacer 1

for total in extras.currencyTotals:
  divider
  center big bold "{{total.currency}} ({{total.count}})"
  divider "-" 33
  kv "MONEY IN" "{{total.moneyIn}}"
  kv "MONEY OUT" "{{total.moneyOut}}"
  kv "NET" "{{total.net}}"
  spacer 1

divider
center big bold "BY TRANSACTION TYPE"
divider
for breakdown in extras.transactionBreakdowns:
  kv "{{breakdown.transactionType}} ({{breakdown.count}})" "{{breakdown.currency}} {{breakdown.totalValue}}"

spacer 2
